[Unit]
Description=Lighter HYPE Market Maker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/LIGHTER_Market_Making
EnvironmentFile=/home/ubuntu/LIGHTER_Market_Making/.env
Environment=LIGHTER_MM_ROOT=/home/ubuntu/LIGHTER_Market_Making
Environment=MARKET_SYMBOL=HYPE
Environment=LIGHTER_MM_CONFIG=/home/ubuntu/LIGHTER_Market_Making/configs/hype_live_mm.json
ExecStart=/home/ubuntu/LIGHTER_Market_Making/run_hype_live.sh
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45
CPUQuota=70%
MemoryMax=900M

[Install]
WantedBy=multi-user.target
